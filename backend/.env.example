# ─── Base de données PostgreSQL ──────────────────────────────────────
# Soit une adresse unique (Render la fournit) :
DATABASE_URL=
# soit les champs séparés (Supabase : Project Settings > Database > Session pooler) :
# Supabase > Project Settings > Database > Connection string > "Session pooler"
# (l'adresse directe db.<ref>.supabase.co n'est pas joignable partout : utilisez le pooler)
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<votre-project-ref>
DB_PASSWORD=<mot-de-passe-de-la-base>
DB_DATABASE=postgres
DB_SSL=true

# Ne mettez true que pour tester en local sur une base vide : TypeORM crée alors les tables.
# Pour une base neuve, exécutez plutôt db/schema.sql (voir DEPLOIEMENT.md).
DB_SYNC=false

# ─── Serveur ─────────────────────────────────────────────────────────
PORT=3001
# En ligne : NODE_ENV=production. Le serveur refuse alors de démarrer sans JWT_SECRET.
NODE_ENV=development

# Clé qui signe les connexions. OBLIGATOIRE en production : une longue chaîne aléatoire, secrète.
# (générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Adresse(s) du site autorisées à appeler l'API, séparées par des virgules.
# En local, laissez vide. En ligne, mettez l'adresse du site, ex: https://gsmpro-app.onrender.com
CORS_ORIGIN=

# ─── Premier démarrage automatique (hébergement) ─────────────────────
# true : sur une base vide, crée les tables (db/schema.sql) et les comptes ci-dessous
AUTO_INIT_DB=false
# true : ce serveur sert aussi le site compilé (une seule adresse pour tout)
SERVE_FRONTEND=false

# ─── Création des comptes (au démarrage si AUTO_INIT_DB=true, ou npm run db:seed) ─
SEED_ADMIN_PASSWORD=
# Comptes supplémentaires (facultatif), au format JSON :
# SEED_USERS=[{"username":"vendeur1","nom":"Ahmed","password":"…","role":"vendeur"}]
