# Supabase Postgres connection
# Find these under Supabase Dashboard > Project Settings > Database > Connection info
DB_HOST=db.<your-project-ref>.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<your-database-password>
DB_DATABASE=postgres
DB_SSL=true

# Set to true only for the first run against a fresh Supabase database, so
# TypeORM creates the tables from the entities. Set back to false afterward.
DB_SYNC=false

# Must match the port the frontend's environment.ts/services expect (3001)
PORT=3001
